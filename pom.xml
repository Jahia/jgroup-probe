<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>jahia-modules</artifactId>
        <groupId>org.jahia.modules</groupId>
        <version>8.1.3.0</version>
    </parent>
    <groupId>org.jahia.community</groupId>
    <artifactId>jgroup-probe</artifactId>
    <name>Server Availability Manager - JGroup Probe</name>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>bundle</packaging>
    <description>The purpose of this module is to add a probe to the Server Availability Manager to check if the JGroups communication channels are behaving correctly</description>

    <scm>
        <connection>scm:git:git@github.com:Jahia/jgroup-probe.git</connection>
        <developerConnection>scm:git:git@github.com:Jahia/jgroup-probe.git</developerConnection>
        <url>scm:git:git@github.com:Jahia/jgroup-probe.git</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <export-package>org.jahia.community.sam.jgroup</export-package>
        <jahia-depends>server-availability-manager</jahia-depends>
        <jahia-deploy-on-site>system</jahia-deploy-on-site>
        <jahia-module-type>system</jahia-module-type>
        <jahia.plugin.version>6.12</jahia.plugin.version>
        <import-package>
            org.jahia.modules.sam;version="[2,4)";resolution:=optional,
            org.jahia.modules.sam.model;version="[2,4)";resolution:=optional
        </import-package>
    </properties>
    <repositories>
        <repository>
            <id>jahia-public</id>
            <name>Jahia Public Repository</name>
            <url>https://devtools.jahia.com/nexus/content/groups/public</url>
            <releases>
                <enabled>true</enabled>
                <updatePolicy>never</updatePolicy>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-RequiredExecutionEnvironment>JavaSE-11</Bundle-RequiredExecutionEnvironment>
                        <Karaf-Commands>org.jahia.community.sam.jgroup.commands.*</Karaf-Commands>
                        <_dsannotations>*</_dsannotations>
                    </instructions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>2.3.2</version>
                <configuration>
                    <compilerVersion>11</compilerVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencies>
        <dependency>
            <groupId>org.jahia.modules</groupId>
            <artifactId>server-availability-manager</artifactId>
            <version>2.2.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.karaf.shell</groupId>
            <artifactId>org.apache.karaf.shell.console</artifactId>
            <version>${karaf.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
